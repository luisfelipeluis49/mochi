# Copy to .env (never commit it). Names follow AGENTS.md section 11 plus MOCHI_* additions.

# --- Agora (needed when MOCHI_AGORA_MODE=real) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_REST_KEY=
AGORA_REST_SECRET=

# --- Shared key Agora sends to our turn endpoint (required) ---
MOCHI_TURN_KEY=change-me
MOCHI_DEVICE_KEY=change-me-too  # the Pi sends it as "Authorization: Bearer <key>"

# --- Public URL Agora's cloud calls (https). Render service URL, or the tunnel URL from scripts/tunnel.sh ---
MOCHI_PUBLIC_URL=http://localhost:8000

# --- Database (D-32): saved words, users and voices survive restarts. Empty = memory only ---
# Render: copy the database's INTERNAL URL (same region and workspace as the service). Never commit it.
# A free Render Postgres expires 30 days after creation; upgrade it before then.
DATABASE_URL=
# Local work (MOCHI_AGORA_MODE=fake only): keep saved words and voices in this JSON file when DATABASE_URL
# is empty, so they survive a restart. scripts/start-dev.sh sets it to .local/mochi-data.json. Refused in real mode.
MOCHI_LOCAL_DATA=

# --- Modes ---
# fake: run without Agora (local development). real: talk to Agora.
MOCHI_AGORA_MODE=fake
# empty_reply (default) or mute_speaker (fallback if an empty reply does not keep the agent silent)
MOCHI_SILENCE_STRATEGY=empty_reply
# true locally; set false on Render unless you need /dev/... for the demo
MOCHI_ENABLE_DEV_ROUTES=true

# --- Language model for words outside the lexicon (optional; rules still work without it) ---
MODEL_API_KEY=
MOCHI_MODEL_BASE_URL=https://api.openai.com/v1
MOCHI_MODEL_NAME=gpt-4o-mini
# For a gpt-5 family model (gpt-5.4-mini judged fastest, see DECISIONS D-29) set this to "none":
MOCHI_MODEL_REASONING_EFFORT=
# two_turns: no unasked hint for two turns after one (AGENTS 7.2). while_shown: only until the
# earlier hint has left the screen, and never the same word twice in a row (DECISIONS D-29).
MOCHI_HINT_COOLDOWN=two_turns

# --- TypeSafe JEV veto (optional): runs beside the hint model and may only BLOCK a hint, never make one.
# Needs MODEL_API_KEY too. Waits at most 0.5 s. Off unless MOCHI_JEV_VETO=true and the key is set.
TYPESAFE_API_KEY=
MOCHI_JEV_VETO=false

# --- Mochi's own voice (needs MODEL_API_KEY; without it Mochi keeps its short fixed lines) ---
# When someone says "Mochi", and for a short while after it spoke, Mochi answers in character: the
# prompt is services/backend/src/mochi_backend/intelligence/character.md. See DECISIONS D-23.
MOCHI_CHARACTER_ENABLED=true
MOCHI_CHARACTER_MODEL_NAME=gpt-5.4-mini
# "none": answer at once, without thinking first (gpt-5 family). Leave empty for gpt-4.1-mini, which rejects it.
MOCHI_CHARACTER_REASONING_EFFORT=none
MOCHI_CHARACTER_TIMEOUT_SECONDS=6
# After Mochi spoke (or was woken on the device), how long the next sentence may still be for it
MOCHI_FOLLOW_UP_SECONDS=20
# Said once when the device was woken by its wake phrase, in the language of that phrase
# (Mochi's character is told it asked exactly this: change both together, see character.md)
MOCHI_GREETING_EN="Hi! What would you like to do today?"
MOCHI_GREETING_PT="Oi! O que você quer fazer hoje?"

# --- Agora channel and uids ---
MOCHI_CHANNEL=mochi-demo
MOCHI_PI_UID=1001
MOCHI_AGENT_UID=1002
MOCHI_TOKEN_TTL_SECONDS=3600

# --- Ears (DECISIONS D-25). Agora bills its own rate either way (first 300 min free). ---
# First choice: OpenAI gpt-4o-transcribe with a prompt that says the speakers mix English and Brazilian
# Portuguese and names the lexicon's words. It needs MODEL_API_KEY, which is then sent to Agora with every
# session start (Agora calls OpenAI with it) and is billed by OpenAI. On 16 mixed-language test clips it kept the
# mixed-in word in 13; ARES with keywords in 10. It is about 0.45 s slower than ARES per sentence, and OpenAI
# lists it as deprecated (shutdown 2027-02-26).
# Fallback, automatic: ARES (Agora's own, included) with the same words as keywords. Used when there is no
# MODEL_API_KEY or when Agora refuses the first request. To use ARES always: MOCHI_ASR_VENDOR=ares.
MOCHI_ASR_VENDOR=openai
# The main language for every vendor but ARES (OpenAI needs exactly one; "en" scored better than "pt")
MOCHI_ASR_LANGUAGE=en-US
MOCHI_ASR_OPENAI_MODEL=gpt-4o-transcribe
# true: the lexicon's words ("adiar", "chave", ...) are named to the recogniser. false: only the names in
# MOCHI_ASR_KEYWORDS. Named words are also "heard" in unclear audio: faint background speech came back as
# "People don't like to adiar reuniões" and got a hint. Without them that did not happen, and adiar,
# guarda-chuva, garfo and geladeira were still written down; "postpone" inside a Portuguese sentence
# became "postone" (DECISIONS D-36).
MOCHI_ASR_LEXICON_WORDS=true
# What the recogniser is told; "Words that may come up: ..." is added from the lexicon and the keywords below
MOCHI_ASR_PROMPT="Two people are practising languages. They speak English and Brazilian Portuguese and often mix both in one sentence. Write every word in the language it was spoken in; never translate."
# ARES hears both at once, as ONE comma-separated string. It has no Brazilian variant: pt-PT stands in. It takes
# NO credential mode (with "managed" Agora answers "vendor 'ares' is not available for the current SKU").
MOCHI_ARES_LANGUAGE=en-US,pt-PT
# Names the recogniser should expect; the lexicon's words are added automatically (ARES takes up to 128)
MOCHI_ASR_KEYWORDS='["Mochi"]'
# Only for other vendors, e.g. Deepgram: MOCHI_ASR_VENDOR=deepgram, MOCHI_ASR_CREDENTIAL_MODE=managed,
# MOCHI_ASR_PARAMS='{"url":"wss://api.deepgram.com/v1/listen","model":"nova-3","language":"multi"}'
MOCHI_ASR_PARAMS='{}'
MOCHI_ASR_CREDENTIAL_MODE=
# language_boost "auto" lets the one voice pronounce English and Portuguese sentences each in its own
# language (accepted by Agora in a live session, 2026-11-20).
MOCHI_TTS_VENDOR=minimax
MOCHI_TTS_PARAMS='{"url":"wss://api.minimax.io/ws/v1/t2a_v2","model":"speech-2.8-turbo","voice_setting":{"voice_id":"English_captivating_female1","speed":1.0},"audio_setting":{"sample_rate":44100},"language_boost":"auto"}'
MOCHI_TTS_CREDENTIAL_MODE=managed
# Below 600 risks splitting "trails off... um" turns in two.
MOCHI_END_OF_SPEECH_SILENCE_MS=600
# Seconds the Agora agent waits after the Pi leaves the channel before it exits (billing guard)
MOCHI_AGENT_IDLE_TIMEOUT_SECONDS=60

# --- Behaviour ---
MOCHI_HINT_TTL_SECONDS=8
MOCHI_DECIDE_TIMEOUT_SECONDS=2
MOCHI_SPEAK_BASE_SECONDS=0.6
MOCHI_SPEAK_SECONDS_PER_WORD=0.45

# --- Server ---
MOCHI_CORS_ORIGINS=*
MOCHI_LOG_LEVEL=INFO
PORT=8000
