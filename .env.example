# Copy to .env (never commit it). Names follow AGENTS.md section 11 plus MOCHI_* additions.

# --- Agora (needed when MOCHI_AGORA_MODE=real) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_REST_KEY=
AGORA_REST_SECRET=

# --- Shared key Agora sends to our turn endpoint (required) ---
MOCHI_TURN_KEY=change-me

# --- Public URL Agora's cloud calls (https). Render service URL, or the tunnel URL from scripts/tunnel.sh ---
MOCHI_PUBLIC_URL=http://localhost:8000

# --- Modes ---
# fake: run without Agora (local development). real: talk to Agora.
MOCHI_AGORA_MODE=fake
# empty_reply (default) or mute_speaker (fallback if an empty reply does not keep the agent silent)
MOCHI_SILENCE_STRATEGY=empty_reply
# true locally; set false on Render unless you need /dev/... for the demo
MOCHI_ENABLE_DEV_ROUTES=true

# --- Language model for words outside the lexicon (optional; rules still work without it) ---
MODEL_API_KEY=
MOCHI_MODEL_BASE_URL=https://api.openai.com/v1
MOCHI_MODEL_NAME=gpt-4o-mini

# --- Agora channel and uids ---
MOCHI_CHANNEL=mochi-demo
MOCHI_PI_UID=1001
MOCHI_AGENT_UID=1002
MOCHI_TOKEN_TTL_SECONDS=3600

# --- Speech (vendor params are JSON objects; see gateway/agora/VERIFIED.md for open questions) ---
MOCHI_ASR_VENDOR=microsoft
MOCHI_ASR_LANGUAGE=en-US
MOCHI_ASR_PARAMS={}
MOCHI_TTS_VENDOR=microsoft
MOCHI_TTS_PARAMS={}
MOCHI_END_OF_SPEECH_SILENCE_MS=900

# --- Behaviour ---
MOCHI_HINT_TTL_SECONDS=8
MOCHI_DECIDE_TIMEOUT_SECONDS=2
MOCHI_SPEAK_BASE_SECONDS=0.6
MOCHI_SPEAK_SECONDS_PER_WORD=0.45

# --- Server ---
MOCHI_CORS_ORIGINS=*
MOCHI_LOG_LEVEL=INFO
PORT=8000
