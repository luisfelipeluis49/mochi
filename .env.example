# Copy to .env (never commit it). Names follow AGENTS.md section 11 plus MOCHI_* additions.

# --- Agora (needed when MOCHI_AGORA_MODE=real) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_REST_KEY=
AGORA_REST_SECRET=

# --- Shared key Agora sends to our turn endpoint (required) ---
MOCHI_TURN_KEY=change-me

# --- Public URL Agora's cloud calls (https). Render service URL, or the tunnel URL from scripts/tunnel.sh ---
MOCHI_PUBLIC_URL=http://localhost:8000

# --- Modes ---
# fake: run without Agora (local development). real: talk to Agora.
MOCHI_AGORA_MODE=fake
# empty_reply (default) or mute_speaker (fallback if an empty reply does not keep the agent silent)
MOCHI_SILENCE_STRATEGY=empty_reply
# true locally; set false on Render unless you need /dev/... for the demo
MOCHI_ENABLE_DEV_ROUTES=true

# --- Language model for words outside the lexicon (optional; rules still work without it) ---
MODEL_API_KEY=
MOCHI_MODEL_BASE_URL=https://api.openai.com/v1
MOCHI_MODEL_NAME=gpt-4o-mini

# --- Mochi's own voice (needs MODEL_API_KEY; without it Mochi keeps its short fixed lines) ---
# When someone says "Mochi", and for a short while after it spoke, Mochi answers in character: the
# prompt is services/backend/src/mochi_backend/intelligence/character.md. See DECISIONS D-23.
MOCHI_CHARACTER_ENABLED=true
MOCHI_CHARACTER_MODEL_NAME=gpt-4.1-mini
MOCHI_CHARACTER_TIMEOUT_SECONDS=6
# After Mochi spoke (or was woken on the device), how long the next sentence may still be for it
MOCHI_FOLLOW_UP_SECONDS=20
# Said once when the device was woken by its wake phrase, in the language of that phrase
MOCHI_GREETING_EN="Hi! I'm listening."
MOCHI_GREETING_PT="Oi! Pode falar."

# --- Agora channel and uids ---
MOCHI_CHANNEL=mochi-demo
MOCHI_PI_UID=1001
MOCHI_AGENT_UID=1002
MOCHI_TOKEN_TTL_SECONDS=3600

# --- Speech (no vendor keys; billed inside Agora's task price, first 300 min free).
# Ears: ARES, Agora's own recogniser, hearing English and Portuguese at once. On mixed speech it made far
# fewer mistakes than Deepgram nova-3 "multi" (hardware/pi-bridge tests, 2026-11-20). ARES has no Brazilian
# variant: pt-PT is its Portuguese. It takes NO credential mode: with "managed" Agora answers "vendor 'ares'
# is not available for the current SKU". Several languages are one comma-separated string.
# To go back to Deepgram: MOCHI_ASR_VENDOR=deepgram, MOCHI_ASR_LANGUAGE=en-US, MOCHI_ASR_KEYWORDS=[],
# MOCHI_ASR_CREDENTIAL_MODE=managed,
# MOCHI_ASR_PARAMS='{"url":"wss://api.deepgram.com/v1/listen","model":"nova-3","language":"multi"}'
# Vendor params are JSON objects; see gateway/agora/VERIFIED.md for open questions. ---
MOCHI_ASR_VENDOR=ares
MOCHI_ASR_LANGUAGE=en-US,pt-PT
# Words the recogniser should expect (ARES only): names it would otherwise misspell.
MOCHI_ASR_KEYWORDS='["Mochi"]'
MOCHI_ASR_PARAMS='{}'
MOCHI_ASR_CREDENTIAL_MODE=
MOCHI_TTS_VENDOR=minimax
MOCHI_TTS_PARAMS='{"url":"wss://api.minimax.io/ws/v1/t2a_v2","model":"speech-2.8-turbo","voice_setting":{"voice_id":"English_captivating_female1","speed":1.0},"audio_setting":{"sample_rate":44100}}'
MOCHI_TTS_CREDENTIAL_MODE=managed
MOCHI_END_OF_SPEECH_SILENCE_MS=900
# Seconds the Agora agent waits after the Pi leaves the channel before it exits (billing guard)
MOCHI_AGENT_IDLE_TIMEOUT_SECONDS=60

# --- Behaviour ---
MOCHI_HINT_TTL_SECONDS=8
MOCHI_DECIDE_TIMEOUT_SECONDS=2
MOCHI_SPEAK_BASE_SECONDS=0.6
MOCHI_SPEAK_SECONDS_PER_WORD=0.45

# --- Server ---
MOCHI_CORS_ORIGINS=*
MOCHI_LOG_LEVEL=INFO
PORT=8000
