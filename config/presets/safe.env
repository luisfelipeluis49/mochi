# SAFE: backend-only levers, no vendor change. Loaded on top of prod.env.
# Drop the work of a turn Agora abandoned or a newer turn replaced (golden data: ~0.4 s queueing).
MOCHI_CANCEL_STALE_TURNS=true
# Ask the character model a second time if the first answer has not come after this many seconds.
MOCHI_CHARACTER_HEDGE_SECONDS=1.0
