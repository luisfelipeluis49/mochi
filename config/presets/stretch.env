# STRETCH: LIKELY + STREAM + a shorter end-of-speech pause, written out in full. Loaded on top of prod.env.
# Keep in step with likely.env and stream.env (tests/unit/test_presets.py checks it).
MOCHI_CANCEL_STALE_TURNS=true
MOCHI_CHARACTER_HEDGE_SECONDS=1.0
MOCHI_ASR_VENDOR=ares
MOCHI_ARES_LANGUAGE=en-US,pt-BR
MOCHI_ASR_LEXICON_WORDS=true
MOCHI_ASR_KEYWORDS='["Mochi","Oi Mochi","guarda chuva","saca rolhas"]'
MOCHI_TTS_VENDOR=cartesia
MOCHI_TTS_CREDENTIAL_MODE=managed
MOCHI_TTS_PARAMS='{"model_id":"sonic-3.6","voice":{"mode":"id","id":"9626c31c-bec5-4cca-baa8-f8ba9e84c8bc"},"output_format":{"container":"raw","sample_rate":44100},"language":"en"}'
MOCHI_STREAM_REPLY=true
# 600 -> 480 ms: about -0.12 s, but may cut people off and split "trails off... um" turns in two.
MOCHI_END_OF_SPEECH_SILENCE_MS=480
