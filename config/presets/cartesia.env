# CARTESIA: Agora-managed Cartesia sonic-3.6 voice instead of MiniMax. Loaded on top of prod.env.
# Probed through Agora /speak on 2026-11-21 with exactly these params: works, first sound ~90 ms vs
# MiniMax ~330 ms. The language is fixed for the whole session ("en"): Portuguese lines and embedded
# words ("You can say: guarda-chuva.") will sound accented; a human must listen (test plan).
# A wrong voice id fails SILENTLY (/join still answers 200, Mochi says nothing).
# Billing under Agora's managed key is NOT documented (Cartesia is not on Agora's included list).
MOCHI_TTS_VENDOR=cartesia
MOCHI_TTS_CREDENTIAL_MODE=managed
# Voice: Jacqueline. Alternative that also worked: Larissa 8d826d43-20ad-4c56-8d37-1048eccca1bf
# (Luana failed silently).
MOCHI_TTS_PARAMS='{"model_id":"sonic-3.6","voice":{"mode":"id","id":"9626c31c-bec5-4cca-baa8-f8ba9e84c8bc"},"output_format":{"container":"raw","sample_rate":44100},"language":"en"}'
# MOCHI_TTS_PARAMS='{"model_id":"sonic-3.6","voice":{"mode":"id","id":"8d826d43-20ad-4c56-8d37-1048eccca1bf"},"output_format":{"container":"raw","sample_rate":44100},"language":"en"}'
