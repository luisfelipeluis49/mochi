# ARES: Agora's own recogniser hearing English and Brazilian Portuguese. Loaded on top of prod.env.
# en-US,pt-BR with these 24 keywords was ACCEPTED by /join on 2026-11-21 (HTTP 200, no credential_mode);
# recognition quality is NOT measured yet: this arm is that measurement.
MOCHI_ASR_VENDOR=ares
MOCHI_ARES_LANGUAGE=en-US,pt-BR
# composition.vocabulary() = MOCHI_ASR_KEYWORDS + (lexicon words only when MOCHI_ASR_LEXICON_WORDS=true).
# prod.env has it false (D-36), which would leave ARES with these 4 words only. true gives exactly the 24
# keywords of the probe (these 4 + the lexicon's 20: adiar postpone guarda-chuva umbrella recibo receipt
# fila queue mala suitcase saca-rolhas corkscrew geladeira fridge chave key atrasar delay reuniao meeting).
# Risk (D-36, seen with gpt-4o-transcribe): named words get "heard" in faint background speech. The test
# plan checks this for ARES too. To test without it: MOCHI_ASR_LEXICON_WORDS=false.
MOCHI_ASR_LEXICON_WORDS=true
MOCHI_ASR_KEYWORDS='["Mochi","Oi Mochi","guarda chuva","saca rolhas"]'
