# PROD: the deployed backend's speech, model and timing settings today (2026-11-21). No secrets.
# Every other preset is loaded ON TOP of this file and lists only what it changes.
# Source of each value: render.yaml (R), round-4 facts from the Render service (F; the dashboard can
# override render.yaml and was not re-read for this file). Check the dashboard before trusting F.

# Ears: OpenAI gpt-4o-transcribe through Agora, with the prompt; lexicon NOT named (D-36) (R)
MOCHI_ASR_VENDOR=openai
MOCHI_ASR_LANGUAGE=en-US
MOCHI_ASR_OPENAI_MODEL=gpt-4o-transcribe
MOCHI_ASR_LEXICON_WORDS=false
MOCHI_ASR_KEYWORDS='["Mochi"]'
MOCHI_ASR_PROMPT="Two people are practising languages. They speak English and Brazilian Portuguese and often mix both in one sentence. Write every word in the language it was spoken in; never translate."
MOCHI_ARES_LANGUAGE=en-US,pt-PT
MOCHI_ASR_PARAMS='{}'
MOCHI_ASR_CREDENTIAL_MODE=

# Voice: Agora-managed MiniMax speech-2.8-turbo, 44.1 kHz (R)
MOCHI_TTS_VENDOR=minimax
MOCHI_TTS_CREDENTIAL_MODE=managed
MOCHI_TTS_PARAMS='{"url":"wss://api.minimax.io/ws/v1/t2a_v2","model":"speech-2.8-turbo","voice_setting":{"voice_id":"English_captivating_female1","speed":1.0},"audio_setting":{"sample_rate":44100},"language_boost":"auto"}'

# Models: gpt-5.4-mini without reasoning for hints (F; render.yaml still says gpt-4o-mini) and for
# Mochi's own voice (settings default, D-25)
MOCHI_MODEL_NAME=gpt-5.4-mini
MOCHI_MODEL_REASONING_EFFORT=none
MOCHI_CHARACTER_MODEL_NAME=gpt-5.4-mini
MOCHI_CHARACTER_REASONING_EFFORT=none
MOCHI_HINT_COOLDOWN=while_shown

# Timing (R)
MOCHI_END_OF_SPEECH_SILENCE_MS=600
MOCHI_AGENT_IDLE_TIMEOUT_SECONDS=60
MOCHI_SILENCE_STRATEGY=empty_reply

# Latency levers on this branch: all off in production
MOCHI_CANCEL_STALE_TURNS=false
MOCHI_CHARACTER_HEDGE_SECONDS=0
MOCHI_STREAM_REPLY=false
