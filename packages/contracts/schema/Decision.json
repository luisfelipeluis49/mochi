{
  "$defs": {
    "DecisionKind": {
      "description": "What `decide()` wants done with a turn.",
      "enum": [
        "IGNORE",
        "SHOW_HINT",
        "SPEAK"
      ],
      "title": "DecisionKind",
      "type": "string"
    },
    "Hint": {
      "additionalProperties": false,
      "description": "One word or short expression shown to help a stuck speaker.\n\nPROPOSAL (not yet signed off, see docs/DECISIONS.md): `candidates` and `context` are\nadditive and optional. They are set only for a hint with no single known word (reasons\ntrails_off, restarts, talks_around): up to three plausible completions instead of one\nguess, plus the sentence they stopped in. Every other reason leaves both `None`, and a\nclient that does not know them still shows `expression`/`meaning` as before.",
      "properties": {
        "candidates": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/HintCandidate"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidates"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Example"
        },
        "expires_at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
          "title": "Expires At",
          "type": "string"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "hint_id": {
          "title": "Hint Id",
          "type": "string"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meaning"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "target_language": {
          "$ref": "#/$defs/Language"
        },
        "target_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target User Id"
        }
      },
      "required": [
        "hint_id",
        "target_user_id",
        "target_language",
        "expression",
        "meaning",
        "example",
        "reason",
        "expires_at"
      ],
      "title": "Hint",
      "type": "object"
    },
    "HintCandidate": {
      "additionalProperties": false,
      "description": "One of up to three plausible words for a hint with no single known answer.",
      "properties": {
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meaning"
        }
      },
      "required": [
        "expression",
        "meaning"
      ],
      "title": "HintCandidate",
      "type": "object"
    },
    "Language": {
      "description": "The two MVP languages.",
      "enum": [
        "en",
        "pt-BR"
      ],
      "title": "Language",
      "type": "string"
    },
    "LearningEvent": {
      "additionalProperties": false,
      "description": "A saved word with its history for one person (a card under My words).",
      "properties": {
        "detection_signal": {
          "$ref": "#/$defs/Reason"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "hint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hint Id"
        },
        "learning_event_id": {
          "title": "Learning Event Id",
          "type": "string"
        },
        "learning_state": {
          "$ref": "#/$defs/LearningState"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meaning"
        },
        "state_history": {
          "items": {
            "$ref": "#/$defs/StateChange"
          },
          "title": "State History",
          "type": "array"
        },
        "target_language": {
          "$ref": "#/$defs/Language"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "User Id"
        }
      },
      "required": [
        "learning_event_id",
        "user_id",
        "target_language",
        "expression",
        "meaning",
        "detection_signal",
        "hint_id",
        "learning_state",
        "state_history"
      ],
      "title": "LearningEvent",
      "type": "object"
    },
    "LearningState": {
      "description": "Progress of one saved word. There is no mastered state and no score.",
      "enum": [
        "DISCOVERED",
        "ASSISTED",
        "REINFORCED",
        "USED_INDEPENDENTLY"
      ],
      "title": "LearningState",
      "type": "string"
    },
    "Reason": {
      "description": "Why a hint was made (`reason` / `detection_signal`).",
      "enum": [
        "code_switch",
        "says_unknown",
        "asks_partner",
        "asks_mochi",
        "trails_off",
        "talks_around",
        "restarts",
        "look_alike",
        "not_understood"
      ],
      "title": "Reason",
      "type": "string"
    },
    "Speak": {
      "additionalProperties": false,
      "description": "Payload of `agent.speak.requested`; also the text returned to Agora.",
      "properties": {
        "language": {
          "$ref": "#/$defs/Language"
        },
        "reason": {
          "$ref": "#/$defs/SpeakReason"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "language",
        "reason"
      ],
      "title": "Speak",
      "type": "object"
    },
    "SpeakReason": {
      "description": "Why Mochi speaks aloud.",
      "enum": [
        "asks_mochi",
        "activity_host"
      ],
      "title": "SpeakReason",
      "type": "string"
    },
    "StateChange": {
      "additionalProperties": false,
      "description": "One entry of a learning event's `state_history`.",
      "properties": {
        "at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
          "title": "At",
          "type": "string"
        },
        "learning_state": {
          "$ref": "#/$defs/LearningState"
        }
      },
      "required": [
        "learning_state",
        "at"
      ],
      "title": "StateChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Result of `decide()`. IGNORE: no hint, no speak. SPEAK: speak set, hint optional.",
  "properties": {
    "decision": {
      "$ref": "#/$defs/DecisionKind"
    },
    "hint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Hint"
        },
        {
          "type": "null"
        }
      ]
    },
    "learning_events": {
      "items": {
        "$ref": "#/$defs/LearningEvent"
      },
      "title": "Learning Events",
      "type": "array"
    },
    "speak": {
      "anyOf": [
        {
          "$ref": "#/$defs/Speak"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "decision",
    "hint",
    "speak",
    "learning_events"
  ],
  "title": "Decision",
  "type": "object"
}
