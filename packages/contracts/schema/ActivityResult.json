{
  "$defs": {
    "Activity": {
      "additionalProperties": false,
      "description": "Payload of `activity.state.changed`. Never carries the secret word while active.\n\nPROPOSAL: the round fields are nullable so an IDLE state can be published\n(AGENTS 6.2 only shows an active example). See docs/DECISIONS.md D-03.",
      "properties": {
        "activity_id": {
          "const": "describe_and_guess",
          "title": "Activity Id",
          "type": "string"
        },
        "describer_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Describer User Id"
        },
        "guesser_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Guesser User Id"
        },
        "public_instruction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Public Instruction"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoundResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "revealed_word": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revealed Word"
        },
        "round_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Round Id"
        },
        "state": {
          "$ref": "#/$defs/GameState"
        },
        "word_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/WordSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "activity_id",
        "round_id",
        "state",
        "describer_user_id",
        "guesser_user_id",
        "public_instruction",
        "result",
        "revealed_word",
        "word_source"
      ],
      "title": "Activity",
      "type": "object"
    },
    "GameState": {
      "description": "Describe & Guess states.",
      "enum": [
        "IDLE",
        "ACTIVE_ROUND",
        "ROUND_RESULT"
      ],
      "title": "GameState",
      "type": "string"
    },
    "Language": {
      "description": "The two MVP languages.",
      "enum": [
        "en",
        "pt-BR"
      ],
      "title": "Language",
      "type": "string"
    },
    "LearningEvent": {
      "additionalProperties": false,
      "description": "A saved word with its history for one person (a card under My words).",
      "properties": {
        "detection_signal": {
          "$ref": "#/$defs/Reason"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "hint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hint Id"
        },
        "learning_event_id": {
          "title": "Learning Event Id",
          "type": "string"
        },
        "learning_state": {
          "$ref": "#/$defs/LearningState"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meaning"
        },
        "state_history": {
          "items": {
            "$ref": "#/$defs/StateChange"
          },
          "title": "State History",
          "type": "array"
        },
        "target_language": {
          "$ref": "#/$defs/Language"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "User Id"
        }
      },
      "required": [
        "learning_event_id",
        "user_id",
        "target_language",
        "expression",
        "meaning",
        "detection_signal",
        "hint_id",
        "learning_state",
        "state_history"
      ],
      "title": "LearningEvent",
      "type": "object"
    },
    "LearningState": {
      "description": "Progress of one saved word. There is no mastered state and no score.",
      "enum": [
        "DISCOVERED",
        "ASSISTED",
        "REINFORCED",
        "USED_INDEPENDENTLY"
      ],
      "title": "LearningState",
      "type": "string"
    },
    "PrivatePrompt": {
      "additionalProperties": false,
      "description": "Payload of `activity.private_prompt`. Delivered to the Home view only.",
      "properties": {
        "describer_user_id": {
          "title": "Describer User Id",
          "type": "string"
        },
        "round_id": {
          "title": "Round Id",
          "type": "string"
        },
        "secret_word": {
          "title": "Secret Word",
          "type": "string"
        },
        "source_learning_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Learning Event Id"
        }
      },
      "required": [
        "round_id",
        "describer_user_id",
        "secret_word",
        "source_learning_event_id"
      ],
      "title": "PrivatePrompt",
      "type": "object"
    },
    "Reason": {
      "description": "Why a hint was made (`reason` / `detection_signal`).",
      "enum": [
        "code_switch",
        "says_unknown",
        "asks_partner",
        "asks_mochi",
        "trails_off",
        "talks_around",
        "restarts",
        "look_alike",
        "not_understood"
      ],
      "title": "Reason",
      "type": "string"
    },
    "RoundResult": {
      "description": "How a round ended.",
      "enum": [
        "guessed",
        "skipped"
      ],
      "title": "RoundResult",
      "type": "string"
    },
    "Speak": {
      "additionalProperties": false,
      "description": "Payload of `agent.speak.requested`; also the text returned to Agora.",
      "properties": {
        "language": {
          "$ref": "#/$defs/Language"
        },
        "reason": {
          "$ref": "#/$defs/SpeakReason"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "language",
        "reason"
      ],
      "title": "Speak",
      "type": "object"
    },
    "SpeakReason": {
      "description": "Why Mochi speaks aloud.",
      "enum": [
        "asks_mochi",
        "activity_host"
      ],
      "title": "SpeakReason",
      "type": "string"
    },
    "StateChange": {
      "additionalProperties": false,
      "description": "One entry of a learning event's `state_history`.",
      "properties": {
        "at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
          "title": "At",
          "type": "string"
        },
        "learning_state": {
          "$ref": "#/$defs/LearningState"
        }
      },
      "required": [
        "learning_state",
        "at"
      ],
      "title": "StateChange",
      "type": "object"
    },
    "WordSource": {
      "description": "Where a round's secret word came from.",
      "enum": [
        "learning_event",
        "stock"
      ],
      "title": "WordSource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "PROVISIONAL: the new round state plus what the gateway must publish.",
  "properties": {
    "activity": {
      "$ref": "#/$defs/Activity"
    },
    "learning_events": {
      "items": {
        "$ref": "#/$defs/LearningEvent"
      },
      "title": "Learning Events",
      "type": "array"
    },
    "private_prompt": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrivatePrompt"
        },
        {
          "type": "null"
        }
      ]
    },
    "speak": {
      "anyOf": [
        {
          "$ref": "#/$defs/Speak"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "activity",
    "private_prompt",
    "speak",
    "learning_events"
  ],
  "title": "ActivityResult",
  "type": "object"
}
