{
  "$defs": {
    "Language": {
      "description": "The two MVP languages.",
      "enum": [
        "en",
        "pt-BR"
      ],
      "title": "Language",
      "type": "string"
    },
    "MemberRole": {
      "description": "What a person may see of their company: `admin` also sees the team view.",
      "enum": [
        "admin",
        "member"
      ],
      "title": "MemberRole",
      "type": "string"
    },
    "User": {
      "additionalProperties": false,
      "description": "One person Mochi knows. Proposed in v0.5 (stored in the database; see DECISIONS D-32).",
      "properties": {
        "comfortable_languages": {
          "items": {
            "$ref": "#/$defs/Language"
          },
          "title": "Comfortable Languages",
          "type": "array"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "target_language": {
          "$ref": "#/$defs/Language"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "display_name",
        "comfortable_languages",
        "target_language"
      ],
      "title": "User",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A member as the company routes return and accept it: the person plus their role.",
  "properties": {
    "role": {
      "$ref": "#/$defs/MemberRole"
    },
    "team": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team"
    },
    "user": {
      "$ref": "#/$defs/User"
    }
  },
  "required": [
    "user",
    "role"
  ],
  "title": "TeamMember",
  "type": "object"
}
