{
  "$defs": {
    "ConversationReport": {
      "additionalProperties": false,
      "description": "Payload of `conversation.report.created`: what Mochi noticed in ONE person's speech in\nONE session, written after it stopped. PROPOSAL (DECISIONS D-54).\n\nIt is that person's alone: their phone gets the event, and only they may read\n`GET /api/users/{id}/reports`. `my_sentences` holds what their registered voice said, never\nwhat others said. Nothing of it is shown during the meeting. `strengths` and `focus_next`\nare short lines in the language the person is at home in.",
      "properties": {
        "company_id": {
          "title": "Company Id",
          "type": "string"
        },
        "ended_at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
          "title": "Ended At",
          "type": "string"
        },
        "focus_next": {
          "items": {
            "type": "string"
          },
          "title": "Focus Next",
          "type": "array"
        },
        "mistakes": {
          "items": {
            "$ref": "#/$defs/Mistake"
          },
          "title": "Mistakes",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/SessionMode"
        },
        "my_sentences": {
          "items": {
            "$ref": "#/$defs/SpokenSentence"
          },
          "title": "My Sentences",
          "type": "array"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Record Id"
        },
        "report_id": {
          "title": "Report Id",
          "type": "string"
        },
        "speaking_minutes": {
          "title": "Speaking Minutes",
          "type": "number"
        },
        "started_at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
          "title": "Started At",
          "type": "string"
        },
        "strengths": {
          "items": {
            "type": "string"
          },
          "title": "Strengths",
          "type": "array"
        },
        "target_language": {
          "$ref": "#/$defs/Language"
        },
        "unknown_words": {
          "items": {
            "$ref": "#/$defs/NeededWord"
          },
          "title": "Unknown Words",
          "type": "array"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "company_id",
        "record_id",
        "user_id",
        "target_language",
        "mode",
        "started_at",
        "ended_at",
        "speaking_minutes",
        "my_sentences",
        "mistakes",
        "unknown_words",
        "strengths",
        "focus_next"
      ],
      "title": "ConversationReport",
      "type": "object"
    },
    "EventType": {
      "description": "WebSocket event types (AGENTS 6.2).",
      "enum": [
        "session.state.changed",
        "hint.created",
        "hint.cleared",
        "learning_event.created",
        "learning_event.updated",
        "agent.speak.requested",
        "transcript.line",
        "conversation.report.created"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Hint": {
      "additionalProperties": false,
      "description": "One word or short expression shown to help a stuck speaker.\n\nPROPOSAL (not yet signed off, see docs/DECISIONS.md): `candidates` and `context` are\nadditive and optional. They are set only for a hint with no single known word (reasons\ntrails_off, restarts, talks_around): up to three plausible completions instead of one\nguess, plus the sentence they stopped in. Every other reason leaves both `None`, and a\nclient that does not know them still shows `expression`/`meaning` as before.",
      "properties": {
        "candidates": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/HintCandidate"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidates"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Example"
        },
        "expires_at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
          "title": "Expires At",
          "type": "string"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "hint_id": {
          "title": "Hint Id",
          "type": "string"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meaning"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "target_language": {
          "$ref": "#/$defs/Language"
        },
        "target_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target User Id"
        }
      },
      "required": [
        "hint_id",
        "target_user_id",
        "target_language",
        "expression",
        "meaning",
        "example",
        "reason",
        "expires_at"
      ],
      "title": "Hint",
      "type": "object"
    },
    "HintCandidate": {
      "additionalProperties": false,
      "description": "One of up to three plausible words for a hint with no single known answer.",
      "properties": {
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meaning"
        }
      },
      "required": [
        "expression",
        "meaning"
      ],
      "title": "HintCandidate",
      "type": "object"
    },
    "HintCleared": {
      "additionalProperties": false,
      "description": "Payload of `hint.cleared`.",
      "properties": {
        "hint_id": {
          "title": "Hint Id",
          "type": "string"
        }
      },
      "required": [
        "hint_id"
      ],
      "title": "HintCleared",
      "type": "object"
    },
    "Language": {
      "description": "The two MVP languages.",
      "enum": [
        "en",
        "pt-BR"
      ],
      "title": "Language",
      "type": "string"
    },
    "LearningEvent": {
      "additionalProperties": false,
      "description": "A saved word with its history for one person (a card under My words).",
      "properties": {
        "detection_signal": {
          "$ref": "#/$defs/Reason"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "hint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hint Id"
        },
        "learning_event_id": {
          "title": "Learning Event Id",
          "type": "string"
        },
        "learning_state": {
          "$ref": "#/$defs/LearningState"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meaning"
        },
        "state_history": {
          "items": {
            "$ref": "#/$defs/StateChange"
          },
          "title": "State History",
          "type": "array"
        },
        "target_language": {
          "$ref": "#/$defs/Language"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "User Id"
        }
      },
      "required": [
        "learning_event_id",
        "user_id",
        "target_language",
        "expression",
        "meaning",
        "detection_signal",
        "hint_id",
        "learning_state",
        "state_history"
      ],
      "title": "LearningEvent",
      "type": "object"
    },
    "LearningState": {
      "description": "Progress of one saved word. There is no mastered state and no score.",
      "enum": [
        "DISCOVERED",
        "ASSISTED",
        "REINFORCED",
        "USED_INDEPENDENTLY"
      ],
      "title": "LearningState",
      "type": "string"
    },
    "MarkKind": {
      "description": "What Mochi noticed in a sentence of the live transcript (PROPOSAL, D-51 to D-53).\n\n`code_switch`: a word of the other language (the speaker also gets a hint for it).\n`idiom` and `technical_term`: something the people listening may not understand.",
      "enum": [
        "code_switch",
        "idiom",
        "technical_term"
      ],
      "title": "MarkKind",
      "type": "string"
    },
    "Mistake": {
      "additionalProperties": false,
      "description": "A mistake a person made in a session: one real example, and how often its kind came up.\n\n`explanation` is one short sentence in the language the person is at home in.",
      "properties": {
        "better": {
          "title": "Better",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Explanation"
        },
        "kind": {
          "$ref": "#/$defs/MistakeKind"
        },
        "said": {
          "title": "Said",
          "type": "string"
        },
        "topic": {
          "$ref": "#/$defs/MistakeTopic"
        }
      },
      "required": [
        "kind",
        "topic",
        "said",
        "better",
        "explanation",
        "count"
      ],
      "title": "Mistake",
      "type": "object"
    },
    "MistakeKind": {
      "description": "What kind of mistake a sentence had (PROPOSAL, DECISIONS D-54).",
      "enum": [
        "grammar",
        "word_choice",
        "false_friend"
      ],
      "title": "MistakeKind",
      "type": "string"
    },
    "MistakeTopic": {
      "description": "The group a mistake belongs to, so the same mistake can be counted across sentences and\npeople. A fixed list: the screen writes the label in the reader's language.",
      "enum": [
        "verb_tense",
        "verb_form",
        "agreement",
        "articles",
        "prepositions",
        "pronouns",
        "plurals",
        "word_order",
        "word_choice",
        "false_friend",
        "other"
      ],
      "title": "MistakeTopic",
      "type": "string"
    },
    "NeededWord": {
      "additionalProperties": false,
      "description": "A word the person needed in the session (from its word moments), and what they said.",
      "properties": {
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meaning"
        },
        "said_instead": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Said Instead"
        },
        "times": {
          "title": "Times",
          "type": "integer"
        }
      },
      "required": [
        "expression",
        "meaning",
        "said_instead",
        "times"
      ],
      "title": "NeededWord",
      "type": "object"
    },
    "Reason": {
      "description": "Why a hint was made (`reason` / `detection_signal`).",
      "enum": [
        "code_switch",
        "says_unknown",
        "asks_partner",
        "asks_mochi",
        "trails_off",
        "talks_around",
        "restarts",
        "look_alike",
        "not_understood"
      ],
      "title": "Reason",
      "type": "string"
    },
    "SessionMode": {
      "description": "The two kinds of session (Papear, v0.7).\n\n`meeting`: people talk to each other at work; Mochi listens, shows a hint when someone is\nstuck and speaks only when asked. `review`: one person goes over their saved words with Mochi\non their phone.",
      "enum": [
        "meeting",
        "review"
      ],
      "title": "SessionMode",
      "type": "string"
    },
    "SessionState": {
      "additionalProperties": false,
      "description": "Payload of `session.state.changed` (AGENTS calls it Session).",
      "properties": {
        "capturing": {
          "title": "Capturing",
          "type": "boolean"
        },
        "focus": {
          "$ref": "#/$defs/Language"
        },
        "mode": {
          "$ref": "#/$defs/SessionMode"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        }
      },
      "required": [
        "status",
        "mode",
        "focus",
        "capturing",
        "participants"
      ],
      "title": "SessionState",
      "type": "object"
    },
    "SessionStatus": {
      "description": "Session lifecycle.",
      "enum": [
        "created",
        "active",
        "paused",
        "ended"
      ],
      "title": "SessionStatus",
      "type": "string"
    },
    "Speak": {
      "additionalProperties": false,
      "description": "Payload of `agent.speak.requested`; also the text returned to Agora.",
      "properties": {
        "language": {
          "$ref": "#/$defs/Language"
        },
        "reason": {
          "$ref": "#/$defs/SpeakReason"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "language",
        "reason"
      ],
      "title": "Speak",
      "type": "object"
    },
    "SpeakReason": {
      "description": "Why Mochi speaks aloud.",
      "enum": [
        "asks_mochi"
      ],
      "title": "SpeakReason",
      "type": "string"
    },
    "SpokenSentence": {
      "additionalProperties": false,
      "description": "One sentence a person said, in a report of their own. `better`: the sentence put right,\nNone when nothing was wrong with it; `topic`: the group its mistake belongs to.",
      "properties": {
        "at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
          "title": "At",
          "type": "string"
        },
        "better": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Better"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "topic": {
          "anyOf": [
            {
              "$ref": "#/$defs/MistakeTopic"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "utterance_id": {
          "title": "Utterance Id",
          "type": "string"
        }
      },
      "required": [
        "utterance_id",
        "at",
        "text"
      ],
      "title": "SpokenSentence",
      "type": "object"
    },
    "StateChange": {
      "additionalProperties": false,
      "description": "One entry of a learning event's `state_history`.",
      "properties": {
        "at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
          "title": "At",
          "type": "string"
        },
        "learning_state": {
          "$ref": "#/$defs/LearningState"
        }
      },
      "required": [
        "learning_state",
        "at"
      ],
      "title": "StateChange",
      "type": "object"
    },
    "TranscriptLine": {
      "additionalProperties": false,
      "description": "Payload of `transcript.line`: one finished sentence, sent as it is said (D-51).\n\nSent to the people in that session, who all heard it; it is not what is stored (that is the\n`Utterance`, which only its speaker may read). The same `utterance_id` is sent again when\nsomething was noticed in the sentence (`marks`): a screen replaces the line it has.\n`user_id` is the person whose registered voice said it, None when no known voice did.",
      "properties": {
        "at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
          "title": "At",
          "type": "string"
        },
        "marks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TranscriptMark"
          },
          "title": "Marks",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "User Id"
        },
        "utterance_id": {
          "title": "Utterance Id",
          "type": "string"
        }
      },
      "required": [
        "utterance_id",
        "user_id",
        "text",
        "at"
      ],
      "title": "TranscriptLine",
      "type": "object"
    },
    "TranscriptMark": {
      "additionalProperties": false,
      "description": "Something Mochi noticed in a sentence, shown with it in the live transcript.\n\n`text` is the part of the sentence it is about. `gloss` is what to read next to it: for a\ncode switch the word in the language being spoken (\"adiar\" -> \"postpone\"), for an idiom or a\ntechnical term what it means in the other language (\"circle back\" -> \"voltar ao assunto\").\n`plain`, for an idiom or a term, says the same in everyday words of the language spoken.",
      "properties": {
        "gloss": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gloss"
        },
        "kind": {
          "$ref": "#/$defs/MarkKind"
        },
        "plain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plain"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "gloss"
      ],
      "title": "TranscriptMark",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One WebSocket message. Only the gateway hub builds these.",
  "properties": {
    "emitted_at": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
      "title": "Emitted At",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionState"
        },
        {
          "$ref": "#/$defs/Hint"
        },
        {
          "$ref": "#/$defs/HintCleared"
        },
        {
          "$ref": "#/$defs/LearningEvent"
        },
        {
          "$ref": "#/$defs/Speak"
        },
        {
          "$ref": "#/$defs/TranscriptLine"
        },
        {
          "$ref": "#/$defs/ConversationReport"
        }
      ],
      "title": "Payload"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/EventType"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "type",
    "session_id",
    "emitted_at",
    "sequence",
    "payload"
  ],
  "title": "Envelope",
  "type": "object"
}
