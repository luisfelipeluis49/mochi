{
  "$defs": {
    "HintCandidate": {
      "additionalProperties": false,
      "description": "One of up to three plausible words for a hint with no single known answer.",
      "properties": {
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meaning"
        }
      },
      "required": [
        "expression",
        "meaning"
      ],
      "title": "HintCandidate",
      "type": "object"
    },
    "Language": {
      "description": "The two MVP languages.",
      "enum": [
        "en",
        "pt-BR"
      ],
      "title": "Language",
      "type": "string"
    },
    "Reason": {
      "description": "Why a hint was made (`reason` / `detection_signal`).",
      "enum": [
        "code_switch",
        "says_unknown",
        "asks_partner",
        "asks_mochi",
        "trails_off",
        "talks_around",
        "restarts",
        "look_alike",
        "not_understood"
      ],
      "title": "Reason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One word or short expression shown to help a stuck speaker.\n\nPROPOSAL (not yet signed off, see docs/DECISIONS.md): `candidates` and `context` are\nadditive and optional. They are set only for a hint with no single known word (reasons\ntrails_off, restarts, talks_around): up to three plausible completions instead of one\nguess, plus the sentence they stopped in. Every other reason leaves both `None`, and a\nclient that does not know them still shows `expression`/`meaning` as before.",
  "properties": {
    "candidates": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/HintCandidate"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidates"
    },
    "context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context"
    },
    "example": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Example"
    },
    "expires_at": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:]{8}\\.\\d{3}Z$",
      "title": "Expires At",
      "type": "string"
    },
    "expression": {
      "title": "Expression",
      "type": "string"
    },
    "hint_id": {
      "title": "Hint Id",
      "type": "string"
    },
    "meaning": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Meaning"
    },
    "reason": {
      "$ref": "#/$defs/Reason"
    },
    "target_language": {
      "$ref": "#/$defs/Language"
    },
    "target_user_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target User Id"
    }
  },
  "required": [
    "hint_id",
    "target_user_id",
    "target_language",
    "expression",
    "meaning",
    "example",
    "reason",
    "expires_at"
  ],
  "title": "Hint",
  "type": "object"
}
